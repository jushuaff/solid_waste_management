APP_NAME="Barangay Solid Waste Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=solid_waste_management
# For production use a replica set/Atlas and transactions enabled
MONGODB_TRANSACTIONS=false

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# For SMTP: MAIL_MAILER=smtp; MAIL_HOST, MAIL_PORT, MAIL_USERNAME,
# MAIL_PASSWORD, MAIL_FROM_ADDRESS; MAIL_SCHEME=tls or null as supported.

INITIAL_ADMIN_NAME="System Administrator"
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
INITIAL_BARANGAY_NAME="Sample Barangay"
BARANGAY_CITY=""
BARANGAY_PROVINCE=""
REPORT_MAX_AGE_DAYS=30

# Optional LOCAL/TESTING demo seed only. NEVER enable in production.
# Creates fictional role accounts with password password1234, plus sample workflows.
SWM_DEMO_SEED=false
